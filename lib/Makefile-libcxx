LIBCXX_OBJS = $(addsuffix .obj, $(basename $(LIBCXX_SRCS)))

$(LIBCXX_SRCS): $(NXDK_DIR)/vendor/llvm

$(NXDK_DIR)/lib/libc++.lib: $(LIBCXX_OBJS)

main.exe: $(NXDK_DIR)/lib/libc++.lib

NXDK_CXXFLAGS += -I${NXDK_DIR}/vendor/llvm/libcxx/src/ -I${NXDK_DIR}/vendor/llvm/libc/ --std=c++23 -D_LIBCPP_BUILDING_LIBRARY

CLEANRULES += clean-libcxx

.PHONY: clean-libcxx
clean-libcxx:
	$(VE)rm -f $(LIBCXX_OBJS) \
	           $(NXDK_DIR)/lib/libc++.lib
